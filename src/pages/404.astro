---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Pagina non trovata — Sito Prezzo Fisso';
const description = 'La pagina richiesta non è disponibile.';
---

<BaseLayout {title} {description} noindex>
  <section class="hero" aria-labelledby="page-title">
    <div class="container">
      <div class="hero-content">
        <p class="eyebrow">Errore 404</p>
        <h1 id="page-title">Pagina non trovata.</h1>
        <p class="hero-copy"><a href="/">Torna alla homepage</a>.</p>
      </div>
    </div>
  </section>
</BaseLayout>
