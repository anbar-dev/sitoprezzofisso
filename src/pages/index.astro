---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Sito web professionale a 399 € | Sito Prezzo Fisso';
const description =
  'Un sito web professionale a 399 €, con prezzo fisso e processo chiaro. Pensato per artigiani, professionisti e piccole attività.';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<BaseLayout {title} {description} {canonical}>
  <section class="hero hero--home" aria-labelledby="page-title">
    <div class="container hero-grid">
      <div class="hero-copy-block">
        <p class="eyebrow">Un sito, un prezzo, un processo chiaro</p>
        <h1 id="page-title">Sito web <em>professionale.</em><br /><strong>399 €.</strong> Prezzo fisso.</h1>
        <p class="hero-lead">
          La presenza online essenziale per artigiani, professionisti e piccole attività che vogliono
          farsi trovare senza trasformare il progetto in una trattativa infinita.
        </p>
        <div class="button-row">
          <a class="button button--primary" href="/prezzi/">Scopri cosa include <span aria-hidden="true">→</span></a>
          <a class="text-link" href="/come-funziona/">Come funziona <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-note"><span class="status-dot" aria-hidden="true"></span> Comunicazione ordinaria via email · niente riunioni inutili</p>
      </div>

      <aside class="price-card" aria-label="Riepilogo dell'offerta base">
        <div class="price-card-top">
          <span>Offerta base</span>
          <span class="card-index">01 / 03</span>
        </div>
        <p class="price"><span>€</span>399</p>
        <p class="price-caption">Prezzo fisso per un sito vetrina semplice, professionale e responsive.</p>
        <ul class="check-list">
          <li>Struttura fino a 3 pagine</li>
          <li>SEO tecnica di base</li>
          <li>Fino a 3 cicli di revisione</li>
        </ul>
        <div class="price-card-foot">
          <span class="line" aria-hidden="true"></span>
          <span>Scope definito prima di iniziare</span>
        </div>
      </aside>
    </div>
  </section>

  <section class="proof-strip" aria-label="Principi del servizio">
    <div class="container proof-grid">
      <p><span>01</span> Prezzo trasparente</p>
      <p><span>02</span> Processo asincrono</p>
      <p><span>03</span> Risultato professionale</p>
    </div>
  </section>

  <section class="section section--paper" id="per-chi" aria-labelledby="for-who-title">
    <div class="container">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Pensato per attività reali</p>
          <h2 id="for-who-title">Una base solida per presentarti online.</h2>
        </div>
        <p>
          Non serve un progetto enorme per avere un sito curato. Serve una struttura chiara, contenuti
          utili e qualcuno che tenga il lavoro dentro un perimetro preciso.
        </p>
      </div>

      <div class="audience-grid">
        <article class="audience-card">
          <span class="card-number">01</span>
          <h3>Artigiani e microimprese</h3>
          <p>Servizi, zone operative e contatti in un posto ordinato, facile da consultare anche dal telefono.</p>
        </article>
        <article class="audience-card audience-card--featured">
          <span class="card-number">02</span>
          <h3>Professionisti</h3>
          <p>Un profilo online credibile per spiegare cosa fai, per chi lavori e come può contattarti.</p>
        </article>
        <article class="audience-card">
          <span class="card-number">03</span>
          <h3>Piccole attività locali</h3>
          <p>Informazioni essenziali, orari e riferimenti per trasformare una visita in una richiesta concreta.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--white" id="cosa-include" aria-labelledby="included-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Cosa comprende</p>
        <h2 id="included-title">Tutto quello che serve per partire bene.</h2>
        <p>
          L'offerta base è pensata per un sito vetrina con scope chiaro. Ogni elemento viene definito
          prima dell'inizio del lavoro.
        </p>
      </div>

      <div class="feature-grid">
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">↗</span>
          <h3>Struttura vetrina</h3>
          <p>Massimo 3 pagine oppure una struttura one-page equivalente, con gerarchia facile da seguire.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">□</span>
          <h3>Responsive</h3>
          <p>Un'esperienza leggibile e utilizzabile su smartphone, tablet e desktop.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">◎</span>
          <h3>SEO tecnica di base</h3>
          <p>Title, meta description, struttura semantica, sitemap e predisposizione Search Console.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">↯</span>
          <h3>Contatti semplici</h3>
          <p>Modulo contatti e, quando serve, pulsante WhatsApp per rendere immediata la richiesta.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">⌁</span>
          <h3>Dominio collegato</h3>
          <p>La configurazione necessaria per pubblicare il sito sul dominio del cliente.</p>
        </article>
        <article class="feature-card">
          <span class="feature-icon" aria-hidden="true">✓</span>
          <h3>Revisioni consolidate</h3>
          <p>Fino a 3 cicli di revisione, con una singola richiesta complessiva per ciclo.</p>
        </article>
      </div>

      <div class="scope-note">
        <div>
          <p class="eyebrow">Per tenere il prezzo chiaro</p>
          <h3>L'offerta base non è un progetto senza limiti.</h3>
        </div>
        <p>
          Ecommerce, gestionali, aree riservate, prenotazioni complesse, branding completo e sviluppo
          custom significativo sono fuori scope. Se ti servono, il percorso giusto è quello per progetti
          avanzati.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ink" id="come-funziona" aria-labelledby="process-title">
    <div class="container">
      <div class="section-heading section-heading--light">
        <p class="eyebrow">Come funziona</p>
        <h2 id="process-title">Poche decisioni. Ben organizzate.</h2>
        <p>Il lavoro procede soprattutto via email, con passaggi leggibili e richieste raccolte in modo ordinato.</p>
      </div>

      <ol class="process-list">
        <li class="process-item">
          <span class="process-number">01</span>
          <div>
            <h3>Raccogliamo le informazioni</h3>
            <p>Ci mandi contenuti, riferimenti, immagini e contatti utili per capire l'attività.</p>
          </div>
        </li>
        <li class="process-item">
          <span class="process-number">02</span>
          <div>
            <h3>Costruiamo la prima versione</h3>
            <p>Organizziamo struttura e contenuti in un sito coerente con il tuo lavoro e il tuo pubblico.</p>
          </div>
        </li>
        <li class="process-item">
          <span class="process-number">03</span>
          <div>
            <h3>Rivediamo e pubblichiamo</h3>
            <p>Raccogliamo fino a 3 richieste consolidate di revisione e prepariamo la pubblicazione.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--accent" id="progetto-avanzato" aria-labelledby="advanced-title">
    <div class="container advanced-grid">
      <div>
        <p class="eyebrow">Un percorso diverso, se serve</p>
        <h2 id="advanced-title">Il tuo progetto è più complesso?</h2>
      </div>
      <div>
        <p>
          Se servono ecommerce, funzioni personalizzate o una struttura più ampia, non forziamo il lavoro
          dentro i 399 €. Puoi richiedere fino a 2 preventivi da professionisti o agenzie partner.
        </p>
        <p class="advanced-note">L'eventuale inoltro dei dati avverrà solo con consenso esplicito.</p>
        <a class="button button--dark" href="/prezzi/">Confronta l'offerta base <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="closing-cta" aria-labelledby="closing-title">
    <div class="container closing-inner">
      <p class="eyebrow">Parti da una base chiara</p>
      <h2 id="closing-title">Un sito professionale, senza sorprese sul prezzo.</h2>
      <a class="button button--primary" href="/richiedi-sito/">Racconta la tua attività <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
