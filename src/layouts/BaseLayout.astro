---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  chrome?: boolean;
}

const { title, description, canonical, noindex = false, chrome = true } = Astro.props;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2MEEQBGW8S"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2MEEQBGW8S');
    </script>
    <SEO {title} {description} {canonical} {noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Vai al contenuto</a>
    {chrome && <Header />}
    <main id="main-content">
      <slot />
    </main>
    {chrome && <Footer />}
  </body>
</html>
